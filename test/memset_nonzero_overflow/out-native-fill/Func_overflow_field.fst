(* The reveal/conceal proofs of a struct carry one hypothesis per field --
   its representation, its length and its alignment -- so the context grows
   with the width of the struct even though each step is arithmetic on
   numerals. Raising the cap costs nothing on the proofs that already go
   through; it only buys room for the wide ones. *)
#set-options "--z3rlimit 40"

open ArrayFill
open Struct_buffer

fn func_overflow_field (var_s: ptr) (#val_s: erased (struct_buffer))
  requires struct_buffer_pts_to var_s 1.0R val_s
  returns  ret_overflow_field : unit
  ensures  exists* (val_s': struct_buffer).
             struct_buffer_pts_to var_s 1.0R val_s'
{
  struct_buffer_focus_bytes var_s;
  array_unsomes uint8_t_repr (var_s +! struct_buffer_offsetof_bytes) 1sz uint8_t_alignof;
  array_uint8_t_1_6_from (var_s +! struct_buffer_offsetof_bytes) (Seq.create 6 255uy) 0sz;
  struct_buffer_unfocus_bytes var_s;
}

