  requires struct_buffer_pts_to a 1.0R x
  ensures  struct_buffer_pts_to_uninit a
{
  unfold struct_buffer_pts_to a 1.0R x;
  array_forget_all uint8_t_repr (a +! struct_buffer_offsetof_bytes) 1sz uint8_t_alignof 5sz;
  int32_t_forget (a +! struct_buffer_offsetof_tag);
  fold struct_buffer_pts_to_uninit a;
}

fn struct_buffer_write_uninit (a: ptr) (x: struct_buffer)
  requires struct_buffer_pts_to_uninit a
  ensures  struct_buffer_pts_to a 1.0R x
{
  unfold struct_buffer_pts_to_uninit a;
  array_uint8_t_1_5_fill (a +! struct_buffer_offsetof_bytes) x.fld_bytes;
  int32_t_write_uninit (a +! struct_buffer_offsetof_tag) x.fld_tag;
  fold struct_buffer_pts_to a 1.0R x;
}

fn struct_buffer_read (a: ptr) (#p: perm) (#x: erased struct_buffer)
  preserves struct_buffer_pts_to a p x
  returns  y : struct_buffer
  ensures  pure (y == reveal x)
  ensures  rewrites_to y (reveal x)
{
  struct_buffer_focus_bytes a;
  let v_bytes = array_uint8_t_1_5_read (a +! struct_buffer_offsetof_bytes);
  struct_buffer_unfocus_read_bytes a;
  struct_buffer_focus_tag a;
  let v_tag = int32_t_read (a +! struct_buffer_offsetof_tag);
  struct_buffer_unfocus_read_tag a;
  ({ fld_bytes = v_bytes; fld_tag = v_tag } <: struct_buffer)
}

fn struct_buffer_write (a: ptr) (x: struct_buffer) (#y: erased struct_buffer)
  requires struct_buffer_pts_to a 1.0R y
  ensures  struct_buffer_pts_to a 1.0R x
{
  struct_buffer_forget a;
  struct_buffer_write_uninit a x;
}

let struct_buffer_repr (x: struct_buffer) (b: bytes) : prop =
  len b == SizeT.v struct_buffer_sizeof /\
  (len b == SizeT.v struct_buffer_sizeof ==>
    array_repr_o uint8_t_repr 1 x.fld_bytes (slice b 0 5) /\
    int32_t_repr x.fld_tag (slice b 8 12))

let struct_buffer_repr_len (x: struct_buffer) (b: bytes)
  : Lemma (requires struct_buffer_repr x b) (ensures len b == SizeT.v struct_buffer_sizeof)
  = ()

let struct_buffer_bytes_slices
  (r0: (b: bytes { len b == 5 }))
  (r1: (b: bytes { len b == 3 }))
  (r2: (b: bytes { len b == 4 }))
  : Lemma (len (append (append r0 r1) r2) == 12 /\
           slice (append (append r0 r1) r2) 0 5 == r0 /\
           slice (append (append r0 r1) r2) 8 12 == r2)
  =
  let s2 = r2 in
  let s1 = append r1 s2 in
  Seq.append_assoc r0 r1 s2;
  slice_append_left_at r0 s1 0 5;
  append_slice_right (append r0 r1) r2;
  ()

ghost fn struct_buffer_reveal (a: ptr) (#p: perm) (#x: struct_buffer)
  requires struct_buffer_pts_to a p x
  ensures  exists* b. mem_pts_to a p b ** pure (struct_buffer_repr x b /\ aligned a struct_buffer_alignof)
{
  unfold struct_buffer_pts_to a p x;
  unfold struct_buffer_padding a p;
  rewrite (array_pts_to uint8_t_repr 1 (SizeT.v uint8_t_alignof) (a +! struct_buffer_offsetof_bytes) p x.fld_bytes)
    as (array_pts_to uint8_t_repr 1 (SizeT.v uint8_t_alignof) a p x.fld_bytes);
  assert (pure (Seq.length x.fld_bytes == 5));
  array_reveal_o uint8_t_repr a 1sz uint8_t_alignof #p #x.fld_bytes;
  with r0. assert (mem_pts_to a p r0 ** pure (array_repr_o uint8_t_repr 1 x.fld_bytes r0));
  assert (pure (len r0 == 5));
  with r1. assert (mem_pts_to (a +! 5sz) p r1 ** pure (len r1 == 3));
  rewrite (int32_t_pts_to (a +! struct_buffer_offsetof_tag) p x.fld_tag)
    as (int32_t_pts_to (a +! 8sz) p x.fld_tag);
  int32_t_reveal (a +! 8sz) #p #x.fld_tag;
  with r2. assert (mem_pts_to (a +! 8sz) p r2 ** pure (int32_t_repr x.fld_tag r2));
  int32_t_repr_len x.fld_tag r2;
  assert (pure (len r2 == 4));
  mem_join a 5sz;
  mem_join a 8sz;
  struct_buffer_bytes_slices r0 r1 r2;
  assert (pure (struct_buffer_repr x (append (append r0 r1) r2)));
}

ghost fn struct_buffer_conceal (a: ptr) (#p: perm) (#b: bytes) (#x: struct_buffer)
  requires mem_pts_to a p b
  requires pure (struct_buffer_repr x b /\ aligned a struct_buffer_alignof)
  ensures  struct_buffer_pts_to a p x
{
  struct_buffer_repr_len x b;
  assert (pure (len b == 12));
  struct_buffer_field_aligned a;
  mem_split a 8sz;
  slice_prefix b 12 0 8;
  slice_prefix b 12 8 12;
  mem_split a 5sz;
  slice_prefix b 8 0 5;
  slice_prefix b 8 5 8;
  array_conceal_o uint8_t_repr a 1sz uint8_t_alignof #p #(slice b 0 5) #(x.fld_bytes);
  rewrite (array_pts_to uint8_t_repr 1 (SizeT.v uint8_t_alignof) a p x.fld_bytes)
    as (array_pts_to uint8_t_repr 1 (SizeT.v uint8_t_alignof) (a +! struct_buffer_offsetof_bytes) p x.fld_bytes);
  int32_t_conceal (a +! 8sz) #p #(slice b 8 12) #(x.fld_tag);
  rewrite (int32_t_pts_to (a +! 8sz) p x.fld_tag)
    as (int32_t_pts_to (a +! struct_buffer_offsetof_tag) p x.fld_tag);
  fold struct_buffer_padding a p;
  fold struct_buffer_pts_to a p x;
}

ghost fn struct_buffer_of_elem (a: ptr) (#p: perm) (#x: struct_buffer)
  requires elem_pts_to struct_buffer_repr a p x
  requires pure (aligned a struct_buffer_alignof)
  ensures  struct_buffer_pts_to a p x
{
  elem_reveal struct_buffer_repr a;
  struct_buffer_conceal a #p #_ #x;
}

ghost fn struct_buffer_to_elem (a: ptr) (#p: perm) (#x: struct_buffer)
  requires struct_buffer_pts_to a p x
  ensures  elem_pts_to struct_buffer_repr a p x
{
  struct_buffer_reveal a;
  elem_conceal struct_buffer_repr a #p #_ #x;
}

