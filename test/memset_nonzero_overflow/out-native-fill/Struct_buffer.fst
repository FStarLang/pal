module Struct_buffer
(* Generated by pal.

   One C declaration in the Palow memory model: the F* type of every parameter,
   the ownership its contract needs, and the body. The module opens exactly the
   earlier declarations it names. See palow.md.

   Where the translation does not cover something it says so and `pal` reports
   an error, so a generated file is never quietly weaker than the C it came
   from. `--palow-permissive` turns those errors back into comments, which is
   what a coverage run wants. *)

#lang-pulse
open Pulse
open Pulse.Lib.C.Palow.Bytes
open Pulse.Lib.C.Palow.Ptr
open Pulse.Lib.C.Palow
open Pulse.Lib.C.Palow.Scalar
open Pulse.Lib.C.Palow.Float
open Pulse.Lib.C.Palow.CTypes
open Pulse.Lib.C.Palow.Machine
open Pulse.Lib.C.Palow.Array
open Pulse.Lib.C.Palow.Unaligned
open Pulse.Lib.C.Palow.ConstSeq
open Pulse.Lib.C.Palow.Local
open Pulse.Lib.C.Palow.Nullable
open Pulse.Lib.C.Palow.Alloc
open Pulse.Lib.C.Palow.FnPtr
open Pulse.Lib.C.Palow.Expose
open Pulse.Lib.C.Palow.Empty
module Seq = FStar.Seq
module Bits = Pulse.Lib.C.Palow.Bits
module ET = Pulse.Lib.C.Palow.Etype
module Int8 = FStar.Int8
module Int16 = FStar.Int16
module Int32 = FStar.Int32
module Int64 = FStar.Int64
module UInt8 = FStar.UInt8
module UInt16 = FStar.UInt16
module UInt32 = FStar.UInt32
module UInt64 = FStar.UInt64
module SizeT = FStar.SizeT
module Float32 = FStar.Float32
module Float64 = FStar.Float64
module Pun = Pulse.Lib.C.Palow.Pun

(* The reveal/conceal proofs of a struct carry one hypothesis per field --
   its representation, its length and its alignment -- so the context grows
   with the width of the struct even though each step is arithmetic on
   numerals. Raising the cap costs nothing on the proofs that already go
   through; it only buys room for the wide ones. *)
#set-options "--z3rlimit 40"

noeq type struct_buffer = { fld_bytes: (s: Seq.seq UInt8.t { Seq.length s == 5 }); fld_tag: Int32.t }

let struct_buffer_sizeof : SizeT.t = 12sz
let struct_buffer_alignof : SizeT.t = 4sz
let struct_buffer_offsetof_bytes : SizeT.t = 0sz
let struct_buffer_offsetof_tag : SizeT.t = 8sz

let struct_buffer_ctype : ET.ctype = ET.TStruct "struct_buffer" 12 [(0, (ET.TArr uint8_t_ctype 5)); (8, int32_t_ctype)]


let struct_buffer_field_aligned (a: ptr)
  : Lemma (requires aligned a struct_buffer_alignof)
          (ensures  array_aligned 1 (SizeT.v uint8_t_alignof) a
                    /\ aligned (a +! struct_buffer_offsetof_tag) int32_t_alignof)
  = aligned_divides a struct_buffer_alignof uint8_t_alignof;
    aligned_field a struct_buffer_alignof struct_buffer_offsetof_tag int32_t_alignof
let struct_buffer_padding (a: ptr) (p: perm) : slprop =
  pure (aligned a struct_buffer_alignof) **
  (exists* g. mem_pts_to (a +! 5sz) p g ** pure (len g == 3))

let struct_buffer_pts_to ([@@@mkey] a: ptr) (p: perm) (x: struct_buffer) : slprop =
  array_pts_to uint8_t_repr 1 (SizeT.v uint8_t_alignof) (a +! struct_buffer_offsetof_bytes) p (x).fld_bytes **
  int32_t_pts_to (a +! struct_buffer_offsetof_tag) p (x).fld_tag **
  struct_buffer_padding a p

let struct_buffer_hole_bytes (a: ptr) (p: perm) (x: struct_buffer) : slprop =
  int32_t_pts_to (a +! struct_buffer_offsetof_tag) p (x).fld_tag **
  struct_buffer_padding a p

ghost fn struct_buffer_focus_bytes (a: ptr) (#p: perm) (#x: struct_buffer)
  requires struct_buffer_pts_to a p x
  ensures  array_pts_to uint8_t_repr 1 (SizeT.v uint8_t_alignof) (a +! struct_buffer_offsetof_bytes) p x.fld_bytes
  ensures  struct_buffer_hole_bytes a p x
{
  unfold struct_buffer_pts_to a p x;
  fold struct_buffer_hole_bytes a p x;
}

ghost fn struct_buffer_unfocus_bytes (a: ptr) (#p: perm) (#x: struct_buffer) (#y: (s: Seq.seq UInt8.t { Seq.length s == 5 }))
  requires struct_buffer_hole_bytes a p x
  requires array_pts_to uint8_t_repr 1 (SizeT.v uint8_t_alignof) (a +! struct_buffer_offsetof_bytes) p y
  ensures  struct_buffer_pts_to a p ({ x with fld_bytes = y })
{
  unfold struct_buffer_hole_bytes a p x;
  fold struct_buffer_pts_to a p ({ x with fld_bytes = y });
}

ghost fn struct_buffer_unfocus_read_bytes (a: ptr) (#p: perm) (#x: struct_buffer)
  requires struct_buffer_hole_bytes a p x
  requires array_pts_to uint8_t_repr 1 (SizeT.v uint8_t_alignof) (a +! struct_buffer_offsetof_bytes) p x.fld_bytes
  ensures  struct_buffer_pts_to a p x
{
  unfold struct_buffer_hole_bytes a p x;
  fold struct_buffer_pts_to a p x;
}

let struct_buffer_hole_tag (a: ptr) (p: perm) (x: struct_buffer) : slprop =
  array_pts_to uint8_t_repr 1 (SizeT.v uint8_t_alignof) (a +! struct_buffer_offsetof_bytes) p (x).fld_bytes **
  struct_buffer_padding a p

ghost fn struct_buffer_focus_tag (a: ptr) (#p: perm) (#x: struct_buffer)
  requires struct_buffer_pts_to a p x
  ensures  int32_t_pts_to (a +! struct_buffer_offsetof_tag) p x.fld_tag
  ensures  struct_buffer_hole_tag a p x
{
  unfold struct_buffer_pts_to a p x;
  fold struct_buffer_hole_tag a p x;
}

ghost fn struct_buffer_unfocus_tag (a: ptr) (#p: perm) (#x: struct_buffer) (#y: Int32.t)
  requires struct_buffer_hole_tag a p x
  requires int32_t_pts_to (a +! struct_buffer_offsetof_tag) p y
  ensures  struct_buffer_pts_to a p ({ x with fld_tag = y })
{
  unfold struct_buffer_hole_tag a p x;
  fold struct_buffer_pts_to a p ({ x with fld_tag = y });
}

ghost fn struct_buffer_unfocus_read_tag (a: ptr) (#p: perm) (#x: struct_buffer)
  requires struct_buffer_hole_tag a p x
  requires int32_t_pts_to (a +! struct_buffer_offsetof_tag) p x.fld_tag
  ensures  struct_buffer_pts_to a p x
{
  unfold struct_buffer_hole_tag a p x;
  fold struct_buffer_pts_to a p x;
}

fn rec array_uint8_t_1_5_from (a: ptr) (vs: (s: Seq.seq UInt8.t { Seq.length s == 5 })) (k: SizeT.t)
                (#xs: erased (xs: Seq.seq (option UInt8.t) { Seq.length xs == 5 }))
  requires array_pts_to (maybe_repr uint8_t_repr 1) 1 (SizeT.v uint8_t_alignof) a 1.0R xs
  requires pure (SizeT.v k <= 5 /\
                 (forall (j: nat). j < SizeT.v k ==> Seq.index xs j == Some (Seq.index vs j)))
  ensures  array_pts_to uint8_t_repr 1 (SizeT.v uint8_t_alignof) a 1.0R vs
  decreases (5 - SizeT.v k)
{
  if (SizeT.lt k 5sz) {
    array_focus (maybe_repr uint8_t_repr 1) a 1sz uint8_t_alignof k (1sz `SizeT.mul` k);
    elem_maybe_reveal uint8_t_repr 1sz (a +! (1sz `SizeT.mul` k));
    uint8_t_claim_uninit (a +! (1sz `SizeT.mul` k));
    uint8_t_write_uninit (a +! (1sz `SizeT.mul` k)) (Seq.index vs (SizeT.v k));
    uint8_t_to_elem (a +! (1sz `SizeT.mul` k));
    elem_maybe_put uint8_t_repr 1sz (a +! (1sz `SizeT.mul` k));
    array_unfocus (maybe_repr uint8_t_repr 1) a 1sz uint8_t_alignof k (1sz `SizeT.mul` k);
    array_uint8_t_1_5_from a vs (k `SizeT.add` 1sz);
  } else {
    array_claim_all uint8_t_repr a 1sz uint8_t_alignof vs;
  }
}

fn array_uint8_t_1_5_fill (a: ptr) (vs: (s: Seq.seq UInt8.t { Seq.length s == 5 }))
  requires array_pts_to_uninit uint8_t_repr 1 (SizeT.v uint8_t_alignof) 5 a
  ensures  array_pts_to uint8_t_repr 1 (SizeT.v uint8_t_alignof) a 1.0R vs
{
  unfold array_pts_to_uninit uint8_t_repr 1 (SizeT.v uint8_t_alignof) 5 a;
  array_uint8_t_1_5_from a vs 0sz;
}

fn rec array_uint8_t_1_5_upto (a: ptr) (k: SizeT.t) (acc: (s: Seq.seq UInt8.t { Seq.length s == SizeT.v k }))
                (#p: perm) (#xs: erased (xs: Seq.seq UInt8.t { Seq.length xs == 5 }))
  preserves array_pts_to uint8_t_repr 1 (SizeT.v uint8_t_alignof) a p xs
  requires pure (SizeT.v k <= 5 /\
                 (forall (j: nat). j < SizeT.v k ==> Seq.index acc j == Seq.index xs j))
returns  r : (s: Seq.seq UInt8.t { Seq.length s == 5 })
  ensures  pure (r == reveal xs)
  decreases (5 - SizeT.v k)
{
  if (SizeT.lt k 5sz) {
    array_focus uint8_t_repr a 1sz uint8_t_alignof k (1sz `SizeT.mul` k);
    uint8_t_of_elem (a +! (1sz `SizeT.mul` k));
    let v = uint8_t_read (a +! (1sz `SizeT.mul` k));
    uint8_t_to_elem (a +! (1sz `SizeT.mul` k));
    array_unfocus_read uint8_t_repr a 1sz uint8_t_alignof k (1sz `SizeT.mul` k);
    array_uint8_t_1_5_upto a (k `SizeT.add` 1sz) (Seq.snoc acc v)
  } else {
    Seq.lemma_eq_intro acc (reveal xs);
    acc
  }
}

fn array_uint8_t_1_5_read (a: ptr) (#p: perm) (#xs: erased (xs: Seq.seq UInt8.t { Seq.length xs == 5 }))
  preserves array_pts_to uint8_t_repr 1 (SizeT.v uint8_t_alignof) a p xs
returns  r : (s: Seq.seq UInt8.t { Seq.length s == 5 })
  ensures  pure (r == reveal xs)
{
  array_uint8_t_1_5_upto a 0sz Seq.empty
}

let struct_buffer_pts_to_uninit (a: ptr) : slprop =
  array_pts_to_uninit uint8_t_repr 1 (SizeT.v uint8_t_alignof) 5 (a +! struct_buffer_offsetof_bytes) **
  int32_t_pts_to_uninit (a +! struct_buffer_offsetof_tag) **
  struct_buffer_padding a 1.0R

ghost fn struct_buffer_scatter_uninit (a: ptr)
  requires struct_buffer_pts_to_uninit a
  ensures  array_pts_to_uninit uint8_t_repr 1 (SizeT.v uint8_t_alignof) 5 (a +! struct_buffer_offsetof_bytes)
  ensures  int32_t_pts_to_uninit (a +! struct_buffer_offsetof_tag)
  ensures  struct_buffer_padding a 1.0R
{
  unfold struct_buffer_pts_to_uninit a;
}

