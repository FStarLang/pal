  requires array_pts_to_uninit uint8_t_repr 1 (SizeT.v uint8_t_alignof) 5 (a +! struct_buffer_offsetof_bytes)
  requires int32_t_pts_to_uninit (a +! struct_buffer_offsetof_tag)
  requires struct_buffer_padding a 1.0R
  ensures  struct_buffer_pts_to_uninit a
