ghost fn struct_buffer_gather (a: ptr) (#p: perm) (#val_bytes: (s: Seq.seq UInt8.t { Seq.length s == 5 })) (#val_tag: Int32.t)
  requires array_pts_to uint8_t_repr 1 (SizeT.v uint8_t_alignof) (a +! struct_buffer_offsetof_bytes) p val_bytes
  requires int32_t_pts_to (a +! struct_buffer_offsetof_tag) p val_tag
  requires struct_buffer_padding a p
  ensures  struct_buffer_pts_to a p ({ fld_bytes = val_bytes; fld_tag = val_tag })
{
  fold struct_buffer_pts_to a p ({ fld_bytes = val_bytes; fld_tag = val_tag });
}

ghost fn struct_buffer_scatter (a: ptr) (#p: perm) (#x: struct_buffer)
  requires struct_buffer_pts_to a p x
  ensures  array_pts_to uint8_t_repr 1 (SizeT.v uint8_t_alignof) (a +! struct_buffer_offsetof_bytes) p ((x).fld_bytes)
  ensures  int32_t_pts_to (a +! struct_buffer_offsetof_tag) p ((x).fld_tag)
  ensures  struct_buffer_padding a p
{
  unfold struct_buffer_pts_to a p x;
}

ghost fn struct_buffer_claim_uninit (a: ptr) (#b: bytes)
  requires mem_pts_to a 1.0R b
  requires pure (len b == SizeT.v struct_buffer_sizeof /\ aligned a struct_buffer_alignof)
  ensures  struct_buffer_pts_to_uninit a
{
  mem_split a 8sz;
  aligned_field a struct_buffer_alignof struct_buffer_offsetof_tag int32_t_alignof;
  int32_t_claim_uninit (a +! 8sz);
  rewrite (int32_t_pts_to_uninit (a +! 8sz))
    as (int32_t_pts_to_uninit (a +! struct_buffer_offsetof_tag));
  mem_split a 5sz;
  aligned_divides a struct_buffer_alignof uint8_t_alignof;
  array_claim_all_uninit uint8_t_repr a 1sz uint8_t_alignof 5sz;
  rewrite (array_pts_to_uninit uint8_t_repr 1 (SizeT.v uint8_t_alignof) 5 a)
    as (array_pts_to_uninit uint8_t_repr 1 (SizeT.v uint8_t_alignof) 5 (a +! struct_buffer_offsetof_bytes));
  fold struct_buffer_padding a 1.0R;
  fold struct_buffer_pts_to_uninit a;
}

fn struct_buffer_stack_alloc ()
  returns a : ptr
  ensures struct_buffer_pts_to_uninit a
{
  let a = mem_stack_alloc struct_buffer_sizeof struct_buffer_alignof;
  struct_buffer_claim_uninit a;
  a
}

ghost fn struct_buffer_reveal_uninit (a: ptr)
  requires struct_buffer_pts_to_uninit a
  ensures  exists* b. mem_pts_to a 1.0R b ** pure (len b == SizeT.v struct_buffer_sizeof /\ aligned a struct_buffer_alignof)
{
  unfold struct_buffer_pts_to_uninit a;
  unfold struct_buffer_padding a 1.0R;
  rewrite (array_pts_to_uninit uint8_t_repr 1 (SizeT.v uint8_t_alignof) 5 (a +! struct_buffer_offsetof_bytes))
    as (array_pts_to_uninit uint8_t_repr 1 (SizeT.v uint8_t_alignof) 5 a);
  array_reveal_all_uninit uint8_t_repr a 1sz uint8_t_alignof 5sz;
  mem_join a 5sz;
  rewrite (int32_t_pts_to_uninit (a +! struct_buffer_offsetof_tag))
    as (int32_t_pts_to_uninit (a +! 8sz));
  int32_t_reveal_uninit (a +! 8sz);
  mem_join a 8sz;
}

fn struct_buffer_stack_free (a: ptr)
  requires struct_buffer_pts_to_uninit a
{
  struct_buffer_reveal_uninit a;
  mem_stack_free a;
}

