.PHONY: all translate verify compile clean

# A test for a translation diagnostic. PAL is expected to reject the input, so
# there is nothing to verify: `verify` instead checks that every substring in
# expected-diagnostics.txt appears in some diagnostic PAL reported. Blank lines
# and `#` comments in that file are ignored. The C file must still compile.

C2PULSE ?= ../../target/debug/pal
FSTAR_EXE ?= ../../opt/run-fstar.sh
CACHE_DIR ?= _cache
OUT_DIR ?= out
OBJ_DIR ?= obj

C_FILES := $(wildcard *.c)
H_FILES := $(wildcard *.h)
PAL_OPTS :=

ifneq ($(wildcard include),)
INCLUDES += -I include
endif
PAL_OPTS += $(INCLUDES)

all: verify compile

translate: $(OUT_DIR)/.stamp

$(OUT_DIR)/.stamp: $(C_FILES) $(H_FILES) $(C2PULSE) pal.h
	@mkdir -p $(OUT_DIR)
	$(C2PULSE) $(PAL_OPTS) --outdir $(OUT_DIR) $(C_FILES)
	@touch $@

verify: $(OUT_DIR)/.stamp
	@python3 ../check-diagnostics.py $(OUT_DIR)/diagnostics.json expected-diagnostics.txt

compile: $(patsubst %.c,$(OBJ_DIR)/%.o,$(C_FILES))

$(OBJ_DIR)/%.o: %.c $(C_FILES) $(H_FILES)
	@mkdir -p $(OBJ_DIR)
	$(CC) $(INCLUDES) -c $< -o $@

clean:
	rm -rf $(OUT_DIR) $(CACHE_DIR) $(OBJ_DIR)
