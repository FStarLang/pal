module ArrayFill
(* Generated by pal.

   One C declaration in the Palow memory model: the F* type of every parameter,
   the ownership its contract needs, and the body. The module opens exactly the
   earlier declarations it names. See palow.md.

   Where the translation does not cover something it says so and `pal` reports
   an error, so a generated file is never quietly weaker than the C it came
   from. `--palow-permissive` turns those errors back into comments, which is
   what a coverage run wants. *)

#lang-pulse
open Pulse
open Pulse.Lib.C.Palow.Bytes
open Pulse.Lib.C.Palow.Ptr
open Pulse.Lib.C.Palow
open Pulse.Lib.C.Palow.Scalar
open Pulse.Lib.C.Palow.Float
open Pulse.Lib.C.Palow.CTypes
open Pulse.Lib.C.Palow.Machine
open Pulse.Lib.C.Palow.Array
open Pulse.Lib.C.Palow.Unaligned
open Pulse.Lib.C.Palow.ConstSeq
open Pulse.Lib.C.Palow.Local
open Pulse.Lib.C.Palow.Nullable
open Pulse.Lib.C.Palow.Alloc
open Pulse.Lib.C.Palow.FnPtr
open Pulse.Lib.C.Palow.Expose
open Pulse.Lib.C.Palow.Empty
module Seq = FStar.Seq
module Bits = Pulse.Lib.C.Palow.Bits
module ET = Pulse.Lib.C.Palow.Etype
module Int8 = FStar.Int8
module Int16 = FStar.Int16
module Int32 = FStar.Int32
module Int64 = FStar.Int64
module UInt8 = FStar.UInt8
module UInt16 = FStar.UInt16
module UInt32 = FStar.UInt32
module UInt64 = FStar.UInt64
module SizeT = FStar.SizeT
module Float32 = FStar.Float32
module Float64 = FStar.Float64
module Pun = Pulse.Lib.C.Palow.Pun

(* The reveal/conceal proofs of a struct carry one hypothesis per field --
   its representation, its length and its alignment -- so the context grows
   with the width of the struct even though each step is arithmetic on
   numerals. Raising the cap costs nothing on the proofs that already go
   through; it only buys room for the wide ones. *)
#set-options "--z3rlimit 40"

fn rec array_uint8_t_1_4_from (a: ptr) (vs: (s: Seq.seq UInt8.t { Seq.length s == 4 })) (k: SizeT.t)
                (#xs: erased (xs: Seq.seq (option UInt8.t) { Seq.length xs == 4 }))
  requires array_pts_to (maybe_repr uint8_t_repr 1) 1 (SizeT.v uint8_t_alignof) a 1.0R xs
  requires pure (SizeT.v k <= 4 /\
                 (forall (j: nat). j < SizeT.v k ==> Seq.index xs j == Some (Seq.index vs j)))
  ensures  array_pts_to uint8_t_repr 1 (SizeT.v uint8_t_alignof) a 1.0R vs
  decreases (4 - SizeT.v k)
{
  if (SizeT.lt k 4sz) {
    array_focus (maybe_repr uint8_t_repr 1) a 1sz uint8_t_alignof k (1sz `SizeT.mul` k);
    elem_maybe_reveal uint8_t_repr 1sz (a +! (1sz `SizeT.mul` k));
    uint8_t_claim_uninit (a +! (1sz `SizeT.mul` k));
    uint8_t_write_uninit (a +! (1sz `SizeT.mul` k)) (Seq.index vs (SizeT.v k));
    uint8_t_to_elem (a +! (1sz `SizeT.mul` k));
    elem_maybe_put uint8_t_repr 1sz (a +! (1sz `SizeT.mul` k));
    array_unfocus (maybe_repr uint8_t_repr 1) a 1sz uint8_t_alignof k (1sz `SizeT.mul` k);
    array_uint8_t_1_4_from a vs (k `SizeT.add` 1sz);
  } else {
    array_claim_all uint8_t_repr a 1sz uint8_t_alignof vs;
  }
}

fn array_uint8_t_1_4_fill (a: ptr) (vs: (s: Seq.seq UInt8.t { Seq.length s == 4 }))
  requires array_pts_to_uninit uint8_t_repr 1 (SizeT.v uint8_t_alignof) 4 a
  ensures  array_pts_to uint8_t_repr 1 (SizeT.v uint8_t_alignof) a 1.0R vs
{
  unfold array_pts_to_uninit uint8_t_repr 1 (SizeT.v uint8_t_alignof) 4 a;
  array_uint8_t_1_4_from a vs 0sz;
}

fn rec array_uint8_t_1_4_upto (a: ptr) (k: SizeT.t) (acc: (s: Seq.seq UInt8.t { Seq.length s == SizeT.v k }))
                (#p: perm) (#xs: erased (xs: Seq.seq UInt8.t { Seq.length xs == 4 }))
  preserves array_pts_to uint8_t_repr 1 (SizeT.v uint8_t_alignof) a p xs
  requires pure (SizeT.v k <= 4 /\
                 (forall (j: nat). j < SizeT.v k ==> Seq.index acc j == Seq.index xs j))
returns  r : (s: Seq.seq UInt8.t { Seq.length s == 4 })
  ensures  pure (r == reveal xs)
  decreases (4 - SizeT.v k)
{
  if (SizeT.lt k 4sz) {
    array_focus uint8_t_repr a 1sz uint8_t_alignof k (1sz `SizeT.mul` k);
    uint8_t_of_elem (a +! (1sz `SizeT.mul` k));
    let v = uint8_t_read (a +! (1sz `SizeT.mul` k));
    uint8_t_to_elem (a +! (1sz `SizeT.mul` k));
    array_unfocus_read uint8_t_repr a 1sz uint8_t_alignof k (1sz `SizeT.mul` k);
    array_uint8_t_1_4_upto a (k `SizeT.add` 1sz) (Seq.snoc acc v)
  } else {
    Seq.lemma_eq_intro acc (reveal xs);
    acc
  }
}

fn array_uint8_t_1_4_read (a: ptr) (#p: perm) (#xs: erased (xs: Seq.seq UInt8.t { Seq.length xs == 4 }))
  preserves array_pts_to uint8_t_repr 1 (SizeT.v uint8_t_alignof) a p xs
returns  r : (s: Seq.seq UInt8.t { Seq.length s == 4 })
  ensures  pure (r == reveal xs)
{
  array_uint8_t_1_4_upto a 0sz Seq.empty
}

